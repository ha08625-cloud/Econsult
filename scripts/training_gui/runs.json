    {
      "id": "smoke-cuda",
      "name": "CUDA smoke test",
      "description": "Torch and the GPU only: a real matmul on the device, plus torch.version.cuda beside the compute capability. Ten seconds, and the first thing to run on a new machine or after any driver or wheel change.",
      "steps": [
        [
          "-m",
          "scripts.encoder_training",
          "smoke-cuda"
        ]
      ]
    },
    {
      "id": "score-companions",
      "name": "Score the companion thresholds",
      "description": "Reads one comparison's six companion-comparison reports back and scores the criterion declared before the run. Pick the report directory the comparison wrote: 'comparison' for the 2x2, 'register' for the register arm. Stdlib only, no GPU, seconds: the cheapest end-to-end check that the console can run something real, and the way to score a run pulled onto another machine.",
      "steps": [
        [
          "-m",
          "scripts.encoder_training",
          "score-companions",
          "--report-dir",
          "{report_dir}"
        ]
      ],
      "parameters": [
        {
          "name": "report_dir",
          "label": "Report directory",
          "choices": [
            "reports/encoder_training/decl/comparison",
            "reports/encoder_training/decl/register"
          ],
          "default": "reports/encoder_training/decl/comparison"
        }
      ]
    },
    {
      "id": "generate-folds",
      "name": "Generate folds for one signal",
      "description": "Fifteen generator runs -- three splits for each of five folds -- under one directory, agreeing on the fold count, salt and seed derivation.",
      "parameters": [
        {
          "name": "signal",
          "label": "Signal",
          "choices": [
            "fever_present",
            "dysuria_present",
            "flank_pain_present",
            "haematuria_present",
            "nocturia_present",
            "urinary_frequency_present"
          ],
          "default": "fever_present"
        }
      ],
      "steps": [
